{
  "name": "lashess-priir",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/rules.test.ts",
    "test:rules": "firebase emulators:exec --project demo-lashess-priir-test --only auth,firestore,storage \"vitest run tests/rules.test.ts\"",
    "bootstrap:owner": "node --env-file=.env.local --import tsx scripts/bootstrap-owner.ts",
    "test:visual": "playwright test",
    "test:foundation": "node scripts/check-foundation.mjs",
    "audit:firestore": "node scripts/audit-firestore.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "next": "15.5.28",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.28",
    "firebase-tools": "^14.0.0",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
